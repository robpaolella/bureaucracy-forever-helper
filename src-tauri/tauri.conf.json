{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bureaucracy Forever Helper",
  "version": "0.1.0",
  "identifier": "com.robpaolella.bureaucracy-forever-helper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bureaucracy Forever Helper",
        "width": 420,
        "height": 640,
        "resizable": false,
        "maximizable": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
